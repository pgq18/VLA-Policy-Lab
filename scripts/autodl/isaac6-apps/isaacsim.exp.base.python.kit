[package]
description = "A trimmed down app for use with python samples"
title = "Isaac Sim Python"
version = "6.0.1"

keywords = ["experience", "app", "usd", "isaacsim"] # That makes it browsable in UI with "experience" filter


[dependencies]
"isaacsim.exp.base" = {}

[settings.app]
name = "Isaac-Sim Python"
version = "6.0.1"
settings.persistent = false        # settings reset on each run with this app
window.title = "Isaac Sim Python"
vulkan = true                      # Explicitly enable Vulkan
enableDeveloperWarnings = false    # disable developer warnings to reduce log noise

[settings.app.exts.folders]
'++' = [
    "/root/autodl-tmp/PressB/.conda/envs/pressb-sim6/lib/python3.12/site-packages/isaacsim/apps",
    "/root/autodl-tmp/PressB/.conda/envs/pressb-sim6/lib/python3.12/site-packages/isaacsim/apps/../exts",
    "/root/autodl-tmp/PressB/.conda/envs/pressb-sim6/lib/python3.12/site-packages/isaacsim/apps/../extscache",
    "/root/autodl-tmp/PressB/.conda/envs/pressb-sim6/lib/python3.12/site-packages/isaacsim/apps/../extsUser",
    "/root/autodl-tmp/PressB/.conda/envs/pressb-sim6/lib/python3.12/site-packages/isaacsim/apps/../extsDeprecated",
]

# PressB captures all task cameras at the same frozen simulation instant.
[settings.rtx.hydra]
supportMultiTickRate = false
