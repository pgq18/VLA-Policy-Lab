{
  "extends": "pap_plus_plus_dsrl.json",
  "name": "autodl_pap_plus_plus_arm6",
  "description": "Apply six joint corrections to actions from the deterministic 30,016-transition PAP++ DSRL checkpoint. The gripper follows the base policy.",
  "nodes": {
    "inference": {
      "server": {
        "port": 19986
      }
    },
    "simulation": {
      "server": {
        "port": 19987
      }
    }
  },
  "task": {
    "config": {
      "log_dir": "${project_root}/outputs/pap_plus_plus_pi05_arm6_autodl/simulation"
    }
  },
  "run": {
    "method": "action_residual",
    "learner": {
      "residual_mode": "all",
      "residual_indices": [
        0,
        1,
        2,
        3,
        4,
        5
      ],
      "residual_scale": [
        0.03,
        0.03,
        0.03,
        0.03,
        0.03,
        0.03
      ],
      "residual_q_bounds": null,
      "noise_steps": 1,
      "noise_scale": 1.5,
