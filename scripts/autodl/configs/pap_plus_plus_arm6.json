      "hidden_dim": 256,
      "batch_size": 256,
      "policy_lr": 0.0001,
      "q_lr": 0.0003,
      "tau": 0.005,
      "init_alpha": 0.01,
      "auto_alpha": true,
      "target_entropy": null,
      "bootstrap_truncated": false,
      "lambda_s": null,
      "lambda_t": null,
      "cartesian_residual": null,
      "action_horizon": 16
    },
    "update": {
      "replay_capacity": 100000,
      "learning_starts": 2000,
      "utd": 1,
      "max_backlog": 1000,
      "max_updates_per_wait": 32,
      "progressive_exploration_steps": 13000
    },
    "checkpoint": {
      "interval": 10000,
      "keep": null,
      "include_replay": true,
      "resume": null
    },
    "frozen_dsrl": {
      "checkpoint": "${project_root}/outputs/pap_plus_plus_pi05_dsrl_100k_4denoise_ckpt10k_20261118/train/checkpoints/step_000000030016.pt",
      "checkpoint_sha256": "eed4feedd20cae4d65427220c88b87ea4bbc09fdec15e8a7395f42a2db0afd96",
      "deterministic": true
    },
    "wandb": {
      "enabled": false,
      "project": "pressb-online-rl",
      "mode": "online",
      "name": "pap-plus-plus-pi05-dsrl30016-arm6-residual003-100k-autodl",
      "tags": [
        "pap-plus-plus",
        "pi05",
        "frozen-dsrl30016",
        "deterministic-dsrl",
        "action-residual",
        "arm6",
        "scale003",
