{
  "extends": "pap_plus_plus_walloss_dsrl.json",
  "name": "pap_plus_plus_walloss_eval",
  "description": "Evaluate the unchanged base PAP Wall-OSS in PAP++, using its smaller box and +3 cm offset; no cross-task RL checkpoint migration.",
  "task": {
    "config": {
      "log_dir": "${project_root}/outputs/pap_plus_plus_walloss_eval/simulation"
    }
  },
  "run": {
    "method": "base",
    "mode": "eval",
    "device": "cpu",
    "rollout": {
      "eval_episodes": 100,
      "max_transitions": 10000,
      "terminal_observation_mode": "full",
      "fused_step_reset": false
    },
    "output_dir": "${project_root}/outputs/pap_plus_plus_walloss_eval/run"
  }
}
