{
  "extends": "fr3_pap_pi05_dsrl_100k.json",
  "name": "fr3_pap_pi05_joint_residual",
  "description": "Short joint SAC run with frozen FR3 pi0.5 step 9339, per-step joint and gripper-closure residuals, and one shared 32-D noise residual.",
  "task": {"config": {
    "num_envs": 2,
    "log_dir": "${project_root}/outputs/fr3_pap_pi05_joint_residual/simulation"
  }},
  "model": {"config": {"device": "cuda:1"}},
  "nodes": {
    "inference": {"server": {"port": 19950}, "service": {"batch_size": 2}},
    "simulation": {"server": {"port": 19951}}
  },
  "run": {
    "method": "joint_residual",
    "device": "cpu",
    "rollout": {"num_envs": 2, "max_transitions": 128, "eval_episodes": 2},
    "learner": {
      "seed": 42,
      "batch_size": 8,
      "target_entropy": null,
      "residual_mode": "all",
      "residual_scale": [0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.025]
    },
    "update": {"replay_capacity": 256, "learning_starts": 8},
    "checkpoint": {"interval": 128, "keep": 1, "include_replay": true},
    "wandb": {"name": "fr3-pap-pi05-joint-residual", "tags": ["fr3-pap", "pi05", "joint-residual"]},
    "output_dir": "${project_root}/outputs/fr3_pap_pi05_joint_residual/train"
  }
}
